# ─── Flask / Servidor ────────────────────────────────────────────────────────
FLASK_ENV=production
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_por_una_cadena_aleatoria_y_segura_32_caracteres

# ─── Base de Datos (PostgreSQL en Producción / Servidor) ────────────────────
DATABASE_URL=postgresql://semimus:semimus123@localhost:5432/semimus
POSTGRES_DB=semimus
POSTGRES_USER=semimus
POSTGRES_PASSWORD=semimus123

# ─── Credenciales del Super Admin y Admin Inicial ────────────────────────────
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@semimus.app
SUPERADMIN_PASSWORD=SuperAdminPass2026!

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@semimus.app
ADMIN_PASSWORD=Semimus2026!

# ─── Almacenamiento de Audio y Límites ───────────────────────────────────────
AUDIO_STORAGE_PATH=storage/audio
MAX_AUDIO_SIZE_MB=50
MAX_UPLOAD_MB=200

# ─── Configuración de Correo (SMTP / Opcional) ───────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion
MAIL_DEFAULT_SENDER=noreply@semimus.app

# ─── Rate Limiting / Cache (Opcional - Redis) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
