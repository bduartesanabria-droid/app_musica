# ─── Flask / Servidor ────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=

# ─── Base de Datos (PostgreSQL en Producción / Servidor) ────────────────────
DATABASE_URL=
POSTGRES_DB=semimus
POSTGRES_USER=semimus
POSTGRES_PASSWORD=

# ─── Credenciales del Super Admin y Admin Inicial ────────────────────────────
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ─── Almacenamiento de Audio y Límites ───────────────────────────────────────
AUDIO_STORAGE_PATH=storage/audio
AVATAR_STORAGE_PATH=instance/avatars
MAX_AUDIO_SIZE_MB=50
MAX_UPLOAD_MB=200
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=180

# ─── Configuración de Correo (SMTP / Opcional) ───────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@semimus.app

# ─── Rate Limiting / Cache (Opcional - Redis) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
